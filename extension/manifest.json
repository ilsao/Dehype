{
    "name": "Dehype",
    "description": "A Chrome extension that removes hype from web pages.",
    "version": "0.0.1",
    "manifest_version": 3,
    "action": {
        "default_popup": "src/popup/popup.html",
        "default_icon": "img/Dehype.png"
    },
    "permissions": ["activeTab", "scripting"],
    "host_permissions": ["https://www.temu.com/*"]
}