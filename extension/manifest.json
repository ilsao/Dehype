{
  "manifest_version": 3,
  "name": "Dehype",
  "version": "0.0.1",
  "description": "A Chrome extension that removes hype from web pages.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "src/popup/popup.html"
  },
  "background": {
    "service_worker": "src/background/background.js"
  },
  "icons": {
    "32": "icons/icon32.png"

  }
}